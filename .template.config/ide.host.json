{
  "$schema": "https://json.schemastore.org/ide.host",
  "icon": "icon.png",
  "description": {
    "text": "An ASP.NET Core Web API with controllers on .NET 10, built with Clean Architecture minus the ceremony. Mug not included."
  },
  "tags": [
    {
      "type": "platform",
      "add": [
        "Linux",
        "macOS",
        "Windows"
      ]
    },
    {
      "type": "projectType",
      "add": [
        "Web",
        "Service"
      ]
    }
  ],
  "symbolInfo": [
    {
      "id": "authorName",
      "name": {
        "text": "Author name"
      },
      "description": {
        "text": "Your name, for the Authors and Copyright lines."
      },
      "isVisible": true,
      "persistenceScope": "shared",
      "persistenceScopeName": "LeanMeanCleanApps"
    },
    {
      "id": "auth",
      "name": {
        "text": "Authentication"
      },
      "description": {
        "text": "How the API checks who is calling. None leaves it open, and you can switch it on later in appsettings.json."
      },
      "isVisible": true,
      "choices": [
        {
          "id": "none",
          "name": {
            "text": "None"
          },
          "description": {
            "text": "No sign in. Everything is open."
          }
        },
        {
          "id": "bearer",
          "name": {
            "text": "JWT bearer tokens"
          },
          "description": {
            "text": "Access tokens from your authorization server."
          }
        }
      ]
    },
    {
      "id": "authority",
      "name": {
        "text": "Token authority"
      },
      "description": {
        "text": "The OAuth authorization server that issues access tokens."
      },
      "isVisible": true
    },
    {
      "id": "audience",
      "name": {
        "text": "Token audience (optional)"
      },
      "description": {
        "text": "Who the tokens are for, usually the API's own URL."
      },
      "isVisible": true
    }
  ]
}
