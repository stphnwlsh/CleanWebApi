{
  "$schema": "https://json.schemastore.org/template",
  "author": "Stephen Walsh",
  "classifications": [
    "Web",
    "WebAPI",
    "API",
    "Service",
    "Clean Architecture"
  ],
  "identity": "CleanWebApi.Template",
  "groupIdentity": "CleanWebApi",
  "generatorVersions": "[1.0.0.0-*)",
  "precedence": "100",
  "name": "Clean Web API Template",
  "description": "An ASP.NET Core Web API with controllers on .NET 10, built with Clean Architecture minus the ceremony.",
  "shortName": "cleanwebapi",
  "tags": {
    "language": "C#",
    "type": "solution"
  },
  "sourceName": "CleanWebApi",
  "defaultName": "WorksOnMyMachine.Movies",
  "preferNameDirectory": true,
  "constraints": {
    "sdk": {
      "type": "sdk-version",
      "args": "[10.0.100,)"
    }
  },
  "primaryOutputs": [
    {
      "path": "CleanWebApi.slnx"
    },
    {
      "path": "docs/RUN.md",
      "condition": "(HostIdentifier != \"dotnetcli\" && HostIdentifier != \"dotnetcli-preview\")"
    }
  ],
  "symbols": {
    "authorName": {
      "type": "parameter",
      "datatype": "string",
      "displayName": "Author name",
      "description": "Who gets the credit in the Authors and Copyright of the Presentation project. Leave it and Stephen Walsh gets the credit, which he'd enjoy more than you would.",
      "defaultValue": "Stephen Walsh",
      "replaces": "Stephen Walsh"
    },
    "auth": {
      "type": "parameter",
      "datatype": "choice",
      "displayName": "Authentication",
      "description": "How the API checks who is calling. Either way, you can change it later in appsettings.json.",
      "choices": [
        {
          "choice": "none",
          "displayName": "None",
          "description": "No sign in. Everything is open, which is fine on your machine and brave anywhere else."
        },
        {
          "choice": "bearer",
          "displayName": "JWT bearer tokens",
          "description": "JWT bearer tokens from your authorization server. Needs --authority."
        }
      ],
      "defaultValue": "none"
    },
    "authority": {
      "type": "parameter",
      "datatype": "string",
      "displayName": "Token authority",
      "description": "The OAuth authorization server that issues access tokens. Required when --auth is bearer.",
      "defaultValue": "",
      "isEnabled": "(auth == \"bearer\")",
      "isRequired": "(auth == \"bearer\")"
    },
    "audience": {
      "type": "parameter",
      "datatype": "string",
      "displayName": "Token audience (optional)",
      "description": "The audience access tokens must be issued for, usually the API's own URL. Not the people in the room, who are lovely but don't carry tokens.",
      "defaultValue": "",
      "isEnabled": "(auth == \"bearer\")"
    },
    "skipRestore": {
      "type": "parameter",
      "datatype": "bool",
      "displayName": "Skip restore",
      "description": "Don't restore packages after the solution is created. Handy on a plane, offline, or when you like to do things yourself.",
      "defaultValue": "false"
    },
    "authorityValue": {
      "type": "generated",
      "generator": "join",
      "replaces": "\"Authority\": \"\"",
      "parameters": {
        "symbols": [
          {
            "type": "const",
            "value": "\"Authority\": \""
          },
          {
            "type": "ref",
            "value": "authority"
          },
          {
            "type": "const",
            "value": "\""
          }
        ]
      }
    },
    "audienceValue": {
      "type": "generated",
      "generator": "join",
      "replaces": "\"Audience\": \"\"",
      "parameters": {
        "symbols": [
          {
            "type": "const",
            "value": "\"Audience\": \""
          },
          {
            "type": "ref",
            "value": "audience"
          },
          {
            "type": "const",
            "value": "\""
          }
        ]
      }
    },
    "HostIdentifier": {
      "type": "bind",
      "binding": "host:HostIdentifier"
    }
  },
  "postActions": [
    {
      "id": "restore",
      "condition": "(!skipRestore)",
      "description": "Restore the NuGet packages the solution needs, so the first build has less to do.",
      "manualInstructions": [
        {
          "text": "Run 'dotnet restore'. It takes less time than reading this sentence twice."
        }
      ],
      "actionId": "210D431B-A78B-4D2F-B762-4ED3E3EA9025",
      "continueOnError": true
    },
    {
      "id": "open-run-guide",
      "condition": "(HostIdentifier != \"dotnetcli\" && HostIdentifier != \"dotnetcli-preview\")",
      "description": "Open the guide to running the solution.",
      "manualInstructions": [
        {
          "text": "Open docs/RUN.md for how to run the solution."
        }
      ],
      "actionId": "84C0DA21-51C8-4541-9940-6CA19AF04EE6",
      "args": {
        "files": "1"
      },
      "continueOnError": true
    },
    {
      "id": "next-steps",
      "condition": "(HostIdentifier == \"dotnetcli\" || HostIdentifier == \"dotnetcli-preview\")",
      "description": "What to do next.",
      "manualInstructions": [
        {
          "text": "All set. Change into the new folder and run 'dotnet run --project ./src/Presentation'. docs/RUN.md covers the rest, and AGENTS.md briefs your coding agents."
        }
      ],
      "actionId": "AC1156F7-BB77-4DB8-B28F-24EEBCCA1E5C",
      "continueOnError": true
    }
  ]
}
