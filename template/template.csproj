<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <PackageType>Template</PackageType>
    <PackageId>CleanWebApi.Template</PackageId>
    <Title>Clean Web API (Controllers) Template</Title>
    <Authors>Stephen Walsh</Authors>
    <Description>A dotnet new template for an ASP.NET Core Web API with controllers, built with a streamlined Clean Architecture on .NET 10.</Description>
    <PackageTags>dotnet;csharp;dotnet-template;template;clean-architecture;cqrs;mediator;fluentvalidation;mapperly;entity-framework-core;docker;aspnetcore;web-api;controllers;rest-api;openapi;clean;cleanarchitecture;lmc;lmca;leanmeanclean;leanmeancleanapps;project-template;solution-template;net10;dotnet10;sqlite;efcore;serilog;opentelemetry;webapi;mvc;api;rest;scalar</PackageTags>
    <PackageProjectUrl>https://leanmeancleanapps.github.io/webapi/</PackageProjectUrl>
    <RepositoryUrl>https://github.com/LeanMeanCleanApps/CleanWebApi</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageLicenseFile>docs/LICENSE.md</PackageLicenseFile>
    <PackageReadmeFile>docs/NUGET.md</PackageReadmeFile>
    <PackageIcon>images/icon.png</PackageIcon>
    <PackageReleaseNotes>https://github.com/LeanMeanCleanApps/CleanWebApi/releases</PackageReleaseNotes>
    <IncludeBuildOutput>false</IncludeBuildOutput>
    <NoWarn>$(NoWarn);NU5128;NU5118</NoWarn>
    <NoDefaultExcludes>true</NoDefaultExcludes>
    <IsTestProject>false</IsTestProject>
    <IsPublishable>false</IsPublishable>
    <!-- Microsoft's template validator checks .template.config on every build and pack. -->
    <ValidateTemplatesPath>$(MSBuildThisFileDirectory)..</ValidateTemplatesPath>
  </PropertyGroup>

  <PropertyGroup>
    <TemplateExcludes>../**/bin/**;../**/obj/**;../**/TestResults/**;../**/*.user;../**/.DS_Store</TemplateExcludes>
    <!-- Skills about the template repository itself (its pipeline, releases and the five-template family) stay out of generated solutions. -->
    <RepositorySkills>../.agents/skills/branches-and-pull-requests/**;../.agents/skills/ci-pipeline/**;../.agents/skills/security-findings/**;../.agents/skills/docs-and-voice/**;../.agents/skills/template-authoring/**;../.agents/skills/family-sync/**;../.agents/skills/releases/**</RepositorySkills>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.TemplateEngine.Authoring.Tasks" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <None Include="../.template.config/**/*" Pack="true" PackagePath="content/.template.config/" />
    <None Include="../src/**/*" Exclude="$(TemplateExcludes)" Pack="true" PackagePath="content/src/" />
    <None Include="../tests/**/*" Exclude="$(TemplateExcludes)" Pack="true" PackagePath="content/tests/" />
    <None Include="../docs/RUN.md" Pack="true" PackagePath="content/docs/" />
    <None Include="../.agents/**/*" Exclude="$(TemplateExcludes);$(RepositorySkills)" Pack="true" PackagePath="content/.agents/" />
    <None Include="../AGENTS.md;../CLAUDE.md" Pack="true" PackagePath="content/" />
    <!-- The starter README and small pipeline a generated solution starts with. The template's own README and Build Pipeline stay out. -->
    <None Include="README.md" Pack="true" PackagePath="content/" />
    <None Include="ci.yml" Pack="true" PackagePath="content/.github/workflows/" />
    <None Include="../*.slnx;../Directory.Build.props;../Directory.Packages.props;../global.json;../NuGet.config;../Dockerfile;../docker-compose.yml;../otel-collector.yaml;../.*ignore;../.editorconfig;../.gitattributes" Pack="true" PackagePath="content/" />
    <None Include="../icon.png" Pack="true" PackagePath="images/" />
    <None Include="../LICENSE.md" Pack="true" PackagePath="docs/" />
    <None Include="../NUGET.md" Pack="true" PackagePath="docs/" />
  </ItemGroup>

</Project>
